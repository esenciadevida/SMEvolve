APP_NAME=SMEvolve
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://smevolve.tech

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smevolve
DB_USERNAME=root
DB_PASSWORD=

AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT=30

AI_ASSISTANT_ENABLED=true
AI_QUOTE_ENABLED=true
AI_WELCOME_MESSAGE="Hi, I'm the SMEvolve AI Assistant. I can help you explore our services, answer questions, or start a quote. How can I help?"

AI_ADMIN_ENABLED=true
AI_ADMIN_EMAIL=admin@smevolve.tech
AI_ADMIN_PASSWORD=

# Admin Portal bootstrap administrator (created by AdministratorSeeder).
# Leave ADMIN_EMAIL / ADMIN_PASSWORD empty to skip creating the account.
ADMIN_NAME="SMEvolve Administrator"
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_LIFETIME_MINUTES=120
ADMIN_LOGIN_RATE_LIMIT=5

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
